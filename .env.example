# neurofiq.in - Environment Variables Template
# Copy this file to .env and fill in the actual values. DO NOT commit .env to version control.

# --- SUPABASE ---
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- GITHUB OAUTH ---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- GO / PYTHON INTERNAL COMMUNICATION ---
INTERNAL_SECRET=your_random_internal_secret

# --- LLM (Python AI Worker uses DeepSeek via Agno) ---
DEEPSEEK_API_KEY=your_deepseek_api_key

SESSION_SECRET=change_me_to_a_long_random_string
APP_ENV=development
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_URL=http://localhost:8080/auth/github/callback
DATABASE_URL=postgres://user:pass@host:5432/neurofiq

# --- VOICE INTEGRATIONS (PHASE 1.5) ---
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# --- RAZORPAY ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

PYTHON_WORKER_URL=http://ai-worker:8000
PORT=8080

EXA_API_KEY=your_exa_api_key
FIRECRAWL_API_KEY=your_firecrawl_api_key
FIRECRAWL_MONTHLY_BUDGET=800
JINA_API_KEY=
