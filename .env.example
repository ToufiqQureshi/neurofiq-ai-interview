# NeuroFIQ Environment Variables
# Copy this file to .env and fill in the actual values. DO NOT commit .env to version control.

# --- DATABASE ---
# Any Postgres connection string. We use Supabase as a managed Postgres only —
# no BaaS SDKs — so this is portable to RDS, Neon, or a container.
DATABASE_URL=postgres://user:pass@host:5432/neurofiq

# Connection pool. GORM's default is unlimited, which a Supabase pooler will
# refuse long before Go stops opening connections.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# --- SUPABASE (optional; only if you use their dashboard/storage) ---
# Get these from your Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- GITHUB OAUTH ---
# Create an OAuth App in GitHub Developer Settings.
# Homepage URL: http://localhost:5173 (local) or https://app.neurofiq.in (prod)
# Callback URL: http://localhost:8080/auth/github/callback (local)
#               https://api.neurofiq.in/auth/github/callback (prod)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
OAUTH_REDIRECT_URL=http://localhost:8080/auth/github/callback

# --- SESSIONS ---
# Signs AND encrypts the session cookie, which carries the user's GitHub token.
# Generate with `openssl rand -hex 32`. Required in production — the server
# refuses to boot without it rather than falling back to a known default.
SESSION_SECRET=change_me_to_a_long_random_string

# --- APP ---
APP_ENV=development
PORT=8080

# Browser origins allowed to call the API. Comma-separated, so the apex domain
# and a preview deployment can both be listed.
FRONTEND_URL=http://localhost:5173

# CIDRs of the proxies you actually run behind (load balancer, Cloudflare).
# Leave empty to trust nothing: the rate limiter then keys on the direct peer
# address, which a client cannot forge with an X-Forwarded-For header.
TRUSTED_PROXIES=

# --- GO / PYTHON INTERNAL COMMUNICATION ---
# A shared secret used to authenticate calls between the Go backend and the
# Python worker. Generate a random string (e.g. `openssl rand -hex 32`) and
# use the same value in both services. The worker fails closed without it.
INTERNAL_SECRET=your_random_internal_secret

# Where Go finds the Python worker.
# Local (Docker): http://ai-worker:8000
# Prod (App Runner): http://<internal-app-runner-url>:8000
PYTHON_WORKER_URL=http://ai-worker:8000

# --- LLM (the Python AI worker uses DeepSeek via Agno) ---
DEEPSEEK_API_KEY=your_deepseek_api_key

# --- VOICE INTEGRATIONS (PHASE 1.5) ---
# Voice currently runs on the browser's Web Speech API at $0. These are only
# needed if you switch to a hosted STT/TTS vendor.
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# --- BILLING (PHASE 2) ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- JOB MAP: SEARCH & SCRAPING ---
# Exa powers company discovery (category="company" returns real company
# homepages instead of blog posts about them). Free tier at https://exa.ai
# Optional — discovery falls back to keyless DuckDuckGo without it.
EXA_API_KEY=your_exa_api_key

# Firecrawl renders JavaScript careers pages and extracts job listings.
# Free tier is 1,000 pages/month at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Stop using Firecrawl credits at this count and fall back to Jina Reader
# (free, keyless). Defaults to 800 of the 1,000 free-tier pages.
FIRECRAWL_MONTHLY_BUDGET=800

# Optional — raises the rate limit on Jina Reader (r.jina.ai works keyless).
JINA_API_KEY=
